---
import { Icon } from 'astro-icon/components'

interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  repo?: string;
}

const { title, description, tags, url, repo } = Astro.props;
---

<article class="rounded-lg border border-gray-200 p-5">
  <h3 class="text-lg font-semibold dark:text-gray-100 text-gray-900">{title}</h3>
  <p class="mt-2 dark:text-gray-50 text-gray-600">{description}</p>
<div class="mt-3 flex flex-wrap items-center justify-between gap-2">
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-full dark:bg-gray-800 bg-gray-100 px-2.5 py-0.5 text-xs dark:text-gray-50 text-gray-600">
        {tag}
      </span>
    ))}
  </div>

  {(url || repo) && (
    <div class="flex gap-4 text-sm">
      {url && (
        <a href={url} class="text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">
      <span class="rounded-full dark:bg-gray-800 bg-gray-100 px-2.5 py-0.5 text-xs dark:text-gray-50 text-gray-600 inline-flex items-center gap-1">Live site <Icon name="solar:square-arrow-right-up-bold"/></span>
        </a>
      )}
      {repo && (
        <a href={repo} class="text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">
          <span class="rounded-full dark:bg-gray-800 bg-gray-100 px-2.5 py-0.5 text-xs dark:text-gray-50 text-gray-600 inline-flex items-center gap-1">Source code <Icon name="solar:programming-bold" /> </span>
        </a>
      )}
    </div>
  )}
</div>
<article>
